# Secrets (SR2): never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Learner progress and its backups stay local (certifications in data/certs/ are reviewed content and kept)
data/*.db
data/*.db.migrating
data/backups/
data/certs/*/questions/*.tmp
# Certification set-ups still in the wizard, and any half-written install
data/drafts/
data/certs/.installing-*

# Installer output
install/install.log
