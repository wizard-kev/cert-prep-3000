# Optional: copy to .env and edit. Every setting has a default. Never commit .env.

# Local port for the app. It always listens on 127.0.0.1 only.
CERTPREP_PORT=8000

# Where progress (progress.db, backups) and certifications (certs/) live, relative to the project root.
CERTPREP_DATA_DIR=data
# Certifications folder, if not <data dir>\certs.
# CERTPREP_CERTS_DIR=data/certs
