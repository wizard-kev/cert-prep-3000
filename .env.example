# Copy to .env and edit. Never commit .env.

# Which model generates questions: ollama (default, local, free) or claude (Phase 2, not enabled yet)
CCST_PROVIDER=ollama

# Ollama (Phase 4 Docker: http://ollama:11434 over the internal network only, SR9)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Context window; the chapter file plus a batch of output must fit
OLLAMA_NUM_CTX=12288
# CPU-only generation is slow; seconds before a request is abandoned
OLLAMA_TIMEOUT_S=1800

# Questions per generation call (max 10)
CCST_BATCH_SIZE=5
# Minimum seconds between generation runs (SR5)
CCST_GENERATE_COOLDOWN_S=10

# Paths, relative to the project root
CCST_OBJECTIVES_DIR=Objective Documents
CCST_DATA_DIR=data

# Phase 2 only. Backend-only; never sent to the browser (SR1).
# ANTHROPIC_API_KEY=
